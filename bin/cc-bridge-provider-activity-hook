#!/usr/bin/env bash
# cc-bridge-provider-activity-hook — bash launcher: resolve symlink, pick a CC_BRIDGE-compatible Python, exec cc-bridge-provider-activity-hook.py
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
exec "$SCRIPT_DIR/_cc-bridge-python" "$SCRIPT_DIR/cc-bridge-provider-activity-hook.py" "$@"
