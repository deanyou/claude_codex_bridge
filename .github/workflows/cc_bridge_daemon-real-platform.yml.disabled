name: CC_BRIDGE_DAEMON Real Platform Smoke

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - dev
  pull_request:

permissions:
  contents: read

concurrency:
  group: cc-bridge-real-platform-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  macos-real:
    name: macOS real cc-bridge-daemon/ask smoke
    runs-on: macos-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Install dependencies
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          python -m pip install pytest tomli jsonschema \
            --requirement deploy/mobile-relay/requirements.txt
          brew install tmux

      - name: Syntax check
        shell: bash
        run: |
          set -euo pipefail
          python -m compileall -q lib bin cc_bridge.py
          bash -n test/system_comm_matrix.sh test/system_linux_soak.sh test/system_fastpath_stress.sh

      - name: Build runtime accelerator
        run: bin/build-cc-bridge-runtime-accelerator

      - name: Verify runtime accelerator ownership
        shell: bash
        run: |
          set -euo pipefail
          PYTHONPATH=lib python - <<'PY'
          import tempfile
          from pathlib import Path

          from runtime_accelerator.lifecycle import maybe_start_runtime_accelerator, stop_runtime_accelerator
          from runtime_accelerator.ownership import load_runtime_accelerator_owner

          with tempfile.TemporaryDirectory(prefix="cc-bridge-accelerator-preflight-") as value:
              root = Path(value)
              handle = None
              try:
                  handle = maybe_start_runtime_accelerator(root)
                  if not handle.started:
                      raise AssertionError(f"runtime accelerator did not start: {handle.error}")
                  owner = load_runtime_accelerator_owner(root)
                  if owner is None:
                      raise AssertionError("runtime accelerator owner was not recorded")
                  print(f"runtime accelerator owner verified: pid={owner.pid}")
              finally:
                  stop_runtime_accelerator(handle)
          PY

      - name: Lifecycle smoke
        shell: bash
        run: |
          set -euo pipefail
          export TERM=xterm-256color
          python -m pytest -q -m cc-bridge_lifecycle_smoke \
            test/test_v2_phase2_entrypoint.py \
            test/test_v2_cc-bridge-daemon_start_matrix.py

      - name: Communication matrix
        shell: bash
        run: |
          set -euo pipefail
          export TERM=xterm-256color
          bash test/system_comm_matrix.sh

      - name: Short soak
        shell: bash
        run: |
          set -euo pipefail
          export TERM=xterm-256color
          CC_BRIDGE_LINUX_SOAK_SECONDS=35 \
          CC_BRIDGE_LINUX_SOAK_KILL_EVERY=2 \
          CC_BRIDGE_LINUX_SOAK_STUB_DELAY=0.2 \
          CC_BRIDGE_LINUX_SOAK_WATCH_TIMEOUT_S=90 \
            bash test/system_linux_soak.sh

      - name: Fastpath stress smoke
        shell: bash
        run: |
          set -euo pipefail
          export TERM=xterm-256color
          CC_BRIDGE_FASTPATH_STRESS_ASK_COUNT=12 \
          CC_BRIDGE_FASTPATH_STRESS_STUB_DELAY=0.3 \
          CC_BRIDGE_FASTPATH_STRESS_WATCH_TIMEOUT_S=240 \
            bash test/system_fastpath_stress.sh

      - name: Storage doctor and cleanup smoke
        shell: bash
        run: |
          set -euo pipefail
          export TERM=xterm-256color
          python - <<'PY'
          import os
          import sys
          from pathlib import Path

          sys.path.insert(0, "lib")
          from storage.paths import PathLayout

          project = Path(os.environ["RUNNER_TEMP"]) / "cc-bridge-storage-cleanup-smoke"
          if project.exists():
              import shutil
              shutil.rmtree(project)
          (project / ".cc-bridge").mkdir(parents=True)
          (project / ".cc-bridge" / "cc-bridge.config").write_text("alpha:claude,gamma:gemini\n", encoding="utf-8")
          layout = PathLayout(project)
          claude_home = layout.agent_provider_state_dir("alpha", "claude") / "home"
          gemini_home = layout.agent_provider_state_dir("gamma", "gemini") / "home"
          for version, body in {"2.1.132": "old", "2.1.133": "rollback", "2.1.137": "current"}.items():
              target = claude_home / ".local" / "share" / "claude" / "versions" / version / "claude"
              target.parent.mkdir(parents=True, exist_ok=True)
              target.write_text(body, encoding="utf-8")
          bin_dir = claude_home / ".local" / "bin"
          bin_dir.mkdir(parents=True, exist_ok=True)
          link = bin_dir / "claude"
          link.unlink(missing_ok=True)
          link.symlink_to("../share/claude/versions/2.1.137/claude")
          for relative, body in {
              ".npm/_cacache/blob": "cache",
              ".cache/node-gyp/state": "nodegyp",
              ".gemini/tmp/session.json": "session",
          }.items():
              target = gemini_home / relative
              target.parent.mkdir(parents=True, exist_ok=True)
              target.write_text(body, encoding="utf-8")
          print(project)
          PY
          project="${RUNNER_TEMP}/cc-bridge-storage-cleanup-smoke"
          export CC_BRIDGE_SOURCE_ALLOWED_ROOTS="$project"
          ./cc-bridge --project "$project" doctor storage --json >"$RUNNER_TEMP/storage-before.json"
          ./cc-bridge --project "$project" cleanup >"$RUNNER_TEMP/cleanup.out"
          ./cc-bridge --project "$project" doctor storage --json >"$RUNNER_TEMP/storage-after.json"
          python - <<'PY'
          import json
          import os
          import sys
          from pathlib import Path

          sys.path.insert(0, "lib")
          from storage.paths import PathLayout

          root = Path(os.environ["RUNNER_TEMP"])
          project = root / "cc-bridge-storage-cleanup-smoke"
          before = json.loads((root / "storage-before.json").read_text(encoding="utf-8"))
          after = json.loads((root / "storage-after.json").read_text(encoding="utf-8"))
          layout = PathLayout(project)
          claude_home = layout.agent_provider_state_dir("alpha", "claude") / "home"
          gemini_home = layout.agent_provider_state_dir("gamma", "gemini") / "home"
          cleanup_text = (root / "cleanup.out").read_text(encoding="utf-8")
          assert "cleanup_status: ok" in cleanup_text
          assert "old_claude_version_cache" in cleanup_text
          assert "rebuildable_gemini_cache" in cleanup_text
          checks = {
              "old_removed": not (claude_home / ".local/share/claude/versions/2.1.132").exists(),
              "rollback_kept": (claude_home / ".local/share/claude/versions/2.1.133/claude").exists(),
              "current_kept": (claude_home / ".local/share/claude/versions/2.1.137/claude").exists(),
              "gemini_cache_removed": not (gemini_home / ".npm/_cacache").exists(),
              "node_gyp_removed": not (gemini_home / ".cache/node-gyp").exists(),
              "gemini_session_kept": (gemini_home / ".gemini/tmp/session.json").exists(),
              "storage_reduced": after["by_class"]["rebuildable_cache"]["bytes"] < before["by_class"]["rebuildable_cache"]["bytes"],
          }
          failed = [name for name, passed in checks.items() if not passed]
          if failed:
              raise AssertionError(f"storage cleanup smoke failed: {failed}")
          PY

      - name: Upload macOS artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: macos-cc-bridge-daemon-real-artifacts
          path: |
            ${{ runner.workspace }}/test_cc-bridge*
          if-no-files-found: ignore

  wsl-real:
    name: WSL mounted-drive cc-bridge-daemon/ask smoke
    runs-on: windows-latest
    timeout-minutes: 60

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup WSL
        uses: Vampire/setup-wsl@v3
        with:
          distribution: Ubuntu-22.04

      - name: Install dependencies in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo apt-get install -y software-properties-common python3 python3-venv python3-pip tmux git curl build-essential
          if ! apt-cache show python3.11 >/dev/null 2>&1; then
            sudo add-apt-repository -y ppa:deadsnakes/ppa
            sudo apt-get update
          fi
          sudo apt-get install -y python3.11 python3.11-venv python3.11-dev
          python3.11 -m venv /tmp/cc-bridge-ci-py311
          /tmp/cc-bridge-ci-py311/bin/python -m pip install --upgrade pip
          /tmp/cc-bridge-ci-py311/bin/python -m pip install pytest tomli jsonschema \
            --requirement deploy/mobile-relay/requirements.txt
          if [ ! -f "$HOME/.cargo/env" ]; then
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
              | sh -s -- -y --profile minimal --default-toolchain stable
          fi

      - name: Build runtime accelerator in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          source "$HOME/.cargo/env"
          bin/build-cc-bridge-runtime-accelerator

      - name: Verify runtime accelerator ownership in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          PYTHONPATH=lib /tmp/cc-bridge-ci-py311/bin/python - <<'PY'
          import tempfile
          from pathlib import Path

          from runtime_accelerator.lifecycle import maybe_start_runtime_accelerator, stop_runtime_accelerator
          from runtime_accelerator.ownership import load_runtime_accelerator_owner

          with tempfile.TemporaryDirectory(prefix="cc-bridge-accelerator-preflight-") as value:
              root = Path(value)
              handle = None
              try:
                  handle = maybe_start_runtime_accelerator(root)
                  if not handle.started:
                      raise AssertionError(f"runtime accelerator did not start: {handle.error}")
                  owner = load_runtime_accelerator_owner(root)
                  if owner is None:
                      raise AssertionError("runtime accelerator owner was not recorded")
                  print(f"runtime accelerator owner verified: pid={owner.pid}")
              finally:
                  stop_runtime_accelerator(handle)
          PY

      - name: Syntax check in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          /tmp/cc-bridge-ci-py311/bin/python -m compileall -q lib bin cc_bridge.py
          bash -n test/system_comm_matrix.sh test/system_linux_soak.sh test/system_fastpath_stress.sh

      - name: Smoke cc-bridge startup from /mnt/c in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python

          repo="$(pwd)"
          project="/mnt/c/Temp/cc-bridge-wsl-mnt-smoke-${{ github.run_id }}-${{ github.run_attempt }}"
          export CC_BRIDGE_SOURCE_ALLOWED_ROOTS="$project"
          rm -rf "$project"
          mkdir -p "$project/.cc-bridge"
          printf 'demo:fake\n' > "$project/.cc-bridge/cc-bridge.config"

          dump_diagnostics() {
            printf '%s\n' '--- start.out ---'
            cat "$project/start.out" 2>/dev/null || true
            printf '%s\n' '--- start.err ---'
            cat "$project/start.err" 2>/dev/null || true
            printf '%s\n' '--- ping.out ---'
            cat "$project/ping.out" 2>/dev/null || true
            printf '%s\n' '--- ping.err ---'
            cat "$project/ping.err" 2>/dev/null || true
            printf '%s\n' '--- doctor.out ---'
            cat "$project/doctor.out" 2>/dev/null || true
            printf '%s\n' '--- doctor.err ---'
            cat "$project/doctor.err" 2>/dev/null || true
            if [ -d "$project/.cc-bridge/cc-bridge-daemon" ]; then
              printf '%s\n' '--- cc-bridge-daemon files ---'
              find "$project/.cc-bridge/cc-bridge-daemon" -maxdepth 1 -type f -print | sort
              for file in "$project"/.cc-bridge/cc-bridge-daemon/*.log "$project"/.cc-bridge/cc-bridge-daemon/*.json; do
                [ -f "$file" ] || continue
                printf '%s\n' "--- $file ---"
                tail -200 "$file" || true
              done
            fi
          }

          cleanup() {
            (cd "$project" && "$repo/cc-bridge" kill -f >/dev/null 2>&1) || true
            rm -rf "$project"
          }
          on_exit() {
            status="$?"
            if [ "$status" -ne 0 ]; then
              dump_diagnostics
            fi
            cleanup
            exit "$status"
          }
          trap on_exit EXIT

          if ! (
            cd "$project"
            CC_BRIDGE_NO_ATTACH=1 \
            CC_BRIDGE_STARTUP_TRANSACTION_TIMEOUT_S=60 \
            CC_BRIDGE_KEEPER_READY_TIMEOUT_S=10 \
            CC_BRIDGE_TMUX_OBJECT_READY_TIMEOUT_S=10 \
            TERM=xterm-256color \
            timeout 90s "$repo/cc-bridge" >start.out 2>start.err
          ); then
            exit 1
          fi

          (cd "$project" && "$repo/cc-bridge" ping cc-bridge-daemon >ping.out 2>ping.err)
          (cd "$project" && "$repo/cc-bridge" doctor >doctor.out 2>doctor.err)

          grep -F 'start_status: ok' "$project/start.out"
          grep -F 'agents: demo' "$project/start.out"
          grep -F 'mount_state: mounted' "$project/ping.out"
          grep -F 'health: healthy' "$project/ping.out"
          grep -F 'runtime_root_kind: relocated' "$project/ping.out"
          grep -F 'runtime_relocation_reason: runtime_root_ref' "$project/ping.out"
          grep -F 'socket_root_kind: runtime' "$project/ping.out"
          grep -F 'tmux_socket_root_kind: runtime' "$project/ping.out"
          grep -F 'cc-bridge-daemon_runtime_root_kind: relocated' "$project/doctor.out"
          grep -F 'cc-bridge-daemon_runtime_relocation_reason: runtime_root_ref' "$project/doctor.out"
          grep -F 'cc-bridge-daemon_socket_root_kind: runtime' "$project/doctor.out"
          grep -F 'cc-bridge-daemon_tmux_socket_root_kind: runtime' "$project/doctor.out"

      - name: Lifecycle smoke in WSL
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          export TERM=xterm-256color
          /tmp/cc-bridge-ci-py311/bin/python -m pytest -q -m cc-bridge_lifecycle_smoke \
            test/test_v2_phase2_entrypoint.py \
            test/test_v2_cc-bridge-daemon_start_matrix.py

      - name: WSL path and relocation tests
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          /tmp/cc-bridge-ci-py311/bin/python -m pytest -q \
            test/test_v2_storage_paths.py \
            test/test_wsl_path_utils.py \
            test/test_opencode_paths_runtime.py \
            test/test_project_id.py \
            -k "wsl or mounted or relocation or socket or path or storage"

      - name: Communication matrix in WSL mounted checkout
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          export TERM=xterm-256color
          bash test/system_comm_matrix.sh

      - name: Short soak in WSL mounted checkout
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          export TERM=xterm-256color
          # The short WSL sample makes nearest-rank p95 equal the maximum.
          CC_BRIDGE_LINUX_SOAK_SECONDS=35 \
          CC_BRIDGE_LINUX_SOAK_KILL_EVERY=2 \
          CC_BRIDGE_LINUX_SOAK_STUB_DELAY=0.2 \
          CC_BRIDGE_LINUX_SOAK_P95_RECEIPT_MS=2500 \
          CC_BRIDGE_LINUX_SOAK_WATCH_TIMEOUT_S=90 \
            bash test/system_linux_soak.sh

      - name: Fastpath stress smoke in WSL mounted checkout
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          export TERM=xterm-256color
          CC_BRIDGE_FASTPATH_STRESS_ASK_COUNT=12 \
          CC_BRIDGE_FASTPATH_STRESS_STUB_DELAY=0.3 \
          CC_BRIDGE_FASTPATH_STRESS_P95_RECEIPT_MS=2500 \
          CC_BRIDGE_FASTPATH_STRESS_WATCH_TIMEOUT_S=240 \
            bash test/system_fastpath_stress.sh

      - name: Storage doctor and cleanup smoke in WSL mounted checkout
        shell: wsl-bash {0}
        run: |
          set -euo pipefail
          export CC_BRIDGE_PYTHON=/tmp/cc-bridge-ci-py311/bin/python
          export TERM=xterm-256color
          smoke_root="/mnt/c/Temp/cc-bridge-storage-cleanup-smoke-${{ github.run_id }}-${{ github.run_attempt }}"
          rm -rf "$smoke_root"
          mkdir -p "$smoke_root/.cc-bridge"
          printf 'alpha:claude,gamma:gemini\n' >"$smoke_root/.cc-bridge/cc-bridge.config"
          /tmp/cc-bridge-ci-py311/bin/python - "$smoke_root" <<'PY'
          import sys
          from pathlib import Path

          sys.path.insert(0, "lib")
          from storage.paths import PathLayout

          project = Path(sys.argv[1])
          layout = PathLayout(project)
          claude_home = layout.agent_provider_state_dir("alpha", "claude") / "home"
          gemini_home = layout.agent_provider_state_dir("gamma", "gemini") / "home"
          for version, body in {"2.1.132": "old", "2.1.133": "rollback", "2.1.137": "current"}.items():
              target = claude_home / ".local" / "share" / "claude" / "versions" / version / "claude"
              target.parent.mkdir(parents=True, exist_ok=True)
              target.write_text(body, encoding="utf-8")
          bin_dir = claude_home / ".local" / "bin"
          bin_dir.mkdir(parents=True, exist_ok=True)
          link = bin_dir / "claude"
          link.unlink(missing_ok=True)
          link.symlink_to("../share/claude/versions/2.1.137/claude")
          for relative, body in {
              ".npm/_cacache/blob": "cache",
              ".cache/node-gyp/state": "nodegyp",
              ".gemini/tmp/session.json": "session",
          }.items():
              target = gemini_home / relative
              target.parent.mkdir(parents=True, exist_ok=True)
              target.write_text(body, encoding="utf-8")
          PY
          export CC_BRIDGE_SOURCE_ALLOWED_ROOTS="$smoke_root"
          ./cc-bridge --project "$smoke_root" doctor storage --json >/tmp/cc-bridge-storage-before.json
          ./cc-bridge --project "$smoke_root" cleanup >/tmp/cc-bridge-cleanup.out
          ./cc-bridge --project "$smoke_root" doctor storage --json >/tmp/cc-bridge-storage-after.json
          /tmp/cc-bridge-ci-py311/bin/python - "$smoke_root" <<'PY'
          import json
          import sys
          from pathlib import Path

          sys.path.insert(0, "lib")
          from storage.paths import PathLayout

          project = Path(sys.argv[1])
          before = json.loads(Path("/tmp/cc-bridge-storage-before.json").read_text(encoding="utf-8"))
          after = json.loads(Path("/tmp/cc-bridge-storage-after.json").read_text(encoding="utf-8"))
          layout = PathLayout(project)
          claude_home = layout.agent_provider_state_dir("alpha", "claude") / "home"
          gemini_home = layout.agent_provider_state_dir("gamma", "gemini") / "home"
          cleanup_text = Path("/tmp/cc-bridge-cleanup.out").read_text(encoding="utf-8")
          assert "cleanup_status: ok" in cleanup_text
          assert "old_claude_version_cache" in cleanup_text
          assert "rebuildable_gemini_cache" in cleanup_text
          assert before["runtime_root_kind"] == "relocated"
          assert before["shared_cache_status"] == "enabled"
          assert before["shared_cache_reason"] == "enabled"
          checks = {
              "old_removed": not (claude_home / ".local/share/claude/versions/2.1.132").exists(),
              "rollback_kept": (claude_home / ".local/share/claude/versions/2.1.133/claude").exists(),
              "current_kept": (claude_home / ".local/share/claude/versions/2.1.137/claude").exists(),
              "gemini_cache_removed": not (gemini_home / ".npm/_cacache").exists(),
              "node_gyp_removed": not (gemini_home / ".cache/node-gyp").exists(),
              "gemini_session_kept": (gemini_home / ".gemini/tmp/session.json").exists(),
              "storage_reduced": after["by_class"]["rebuildable_cache"]["bytes"] < before["by_class"]["rebuildable_cache"]["bytes"],
          }
          failed = [name for name, passed in checks.items() if not passed]
          if failed:
              raise AssertionError(f"storage cleanup smoke failed: {failed}")
          PY
          rm -rf "$smoke_root"

      - name: Upload WSL artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: wsl-cc-bridge-daemon-real-artifacts
          path: |
            ${{ runner.workspace }}/test_cc-bridge*
          if-no-files-found: ignore
