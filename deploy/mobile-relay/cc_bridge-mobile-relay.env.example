# CC_BRIDGE Mobile production relay environment template.
# Do not put raw invitations, device tokens, service-account files, or CC_BRIDGE
# project data in this file.

PYTHONPATH=/opt/cc-bridge-source/lib
PYTHONUNBUFFERED=1
CC_BRIDGE_RELAY_LISTEN=127.0.0.1:18444
CC_BRIDGE_RELAY_ADMIN_LISTEN=127.0.0.1:18445
# Public origin differs from the loopback listener and must have a certificate
# trusted by phones.
CC_BRIDGE_RELAY_PUBLIC_ORIGIN=wss://relay.example.com
CC_BRIDGE_RELAY_STATE_DIR=/var/lib/cc-bridge-mobile-relay
CC_BRIDGE_RELAY_ADMISSION_DB=/var/lib/cc-bridge-mobile-relay/relay-admission.sqlite3

# Deployment-owned secret file. It must be mode 0600 and contain:
# {"verifier_key_b64":"...","capability_key_b64":"..."}
CC_BRIDGE_RELAY_ADMISSION_SECRETS=/etc/cc-bridge/mobile-relay-admission-secrets.json

# The relay process terminates TLS itself when binding directly.
# If nginx terminates public TLS, keep this process on loopback with its own
# local TLS certificate or use explicit loopback-only test mode for local labs.
CC_BRIDGE_RELAY_TLS_CERT=/etc/cc-bridge/mobile-relay-local.crt
CC_BRIDGE_RELAY_TLS_KEY=/etc/cc-bridge/mobile-relay-local.key

CC_BRIDGE_RELAY_MAX_FRAME_BYTES=786432
CC_BRIDGE_RELAY_WEBSOCKET_MAX_MSG_BYTES=790528
CC_BRIDGE_RELAY_PEER_QUEUE_LIMIT=8
CC_BRIDGE_RELAY_WRITE_TIMEOUT_SECONDS=5
CC_BRIDGE_RELAY_HANDSHAKE_TIMEOUT_SECONDS=10
CC_BRIDGE_RELAY_IDLE_TIMEOUT_SECONDS=60
CC_BRIDGE_RELAY_HEARTBEAT_INTERVAL_SECONDS=20
CC_BRIDGE_RELAY_UNAUTH_RATE_LIMIT=30
CC_BRIDGE_RELAY_UNAUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Only these peers may supply X-CC_BRIDGE-Client-IP / X-Forwarded-For for rate
# limiting. Use an empty value when there is no reverse proxy.
CC_BRIDGE_RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
